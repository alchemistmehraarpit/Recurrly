# Copy to .env and fill in with your own Clerk instance key.
# Get it from https://dashboard.clerk.com -> API Keys -> Publishable key.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, so this is
# a client-visible value, not a secret. Release builds must still get their own
# key injected by the build environment (EAS env vars / CI) rather than a
# committed one, so a dev instance never ships to production.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
